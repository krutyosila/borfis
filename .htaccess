# Börfi's — Apache (Hestia nginx+apache şablonu için)
Options -Indexes
DirectoryIndex index.php

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|md|lock|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(woff2|webp|jpg|jpeg|png|svg|ico|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
